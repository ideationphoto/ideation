{
  "expo": {
    "name": "구도 가이드",
    "slug": "ideathon-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-image-picker",
      "expo-media-library"
    ],
    "ios": {
      "bundleIdentifier": "com.ideathon.app",
      "infoPlist": {
        "NSCameraUsageDescription": "카메라로 구도를 맞추기 위해 필요합니다.",
        "NSPhotoLibraryUsageDescription": "레퍼런스 사진 선택을 위해 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "찍은 사진을 갤러리에 저장하기 위해 필요합니다."
      }
    },
    "android": {
      "package": "com.ideathon.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "usesCleartextTraffic": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8226a167-bcb1-4d56-bfce-95d844c0de83"
      }
    }
  }
}
